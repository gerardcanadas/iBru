{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · %@" : {
      "comment" : "A secondary line of text that provides dosage and frequency information for a medication linked to an illness record.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ already has an active schedule. End the current schedule before adding a new one." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ja té un horari actiu. Finalitza l'horari actual abans d'afegir-ne un de nou."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya tiene un horario activo. Finaliza el horario actual antes de añadir uno nuevo."
          }
        }
      }
    },
    "%@ was last given %@. The usual interval is %@h." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es va administrar per últim cop %@. L'interval habitual és de %@ hores."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se administró por última vez %@. El intervalo habitual es de %@ horas."
          }
        }
      }
    },
